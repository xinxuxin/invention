OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
AGENT_MODEL_MODE=openai
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIES=3
VERIFIER_MODE=hybrid
LLM_VERIFIER_ENABLED=true
LLM_VERIFIER_MODEL=gpt-4.1-mini
LLM_VERIFIER_TIMEOUT_SECONDS=6
LLM_VERIFIER_MAX_TOKENS=700
LLM_VERIFIER_MAX_INPUT_CHARS=12000
LLM_VERIFIER_MIN_CONFIDENCE=0.70
LLM_VERIFIER_FAIL_OPEN=true
LLM_VERIFIER_HARD_RULE_AUTHORITY=false
VERIFIER_TIME_BUDGET_PER_TURN_SECONDS=8
VERIFIER_SKIP_LLM_AFTER_STEP=4
FRONTEND_INLINE_TABLE_MAX_ROWS=50
FRONTEND_INLINE_TABLE_MAX_COLUMNS=30
FRONTEND_CELL_MAX_CHARS=200
FRONTEND_CHART_MAX_POINTS=500
DATABASE_URL=sqlite:///./data_analysis_agent.db
STORAGE_DIR=.data
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
